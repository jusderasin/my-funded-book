# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role (SECRÈTE — jamais côté client, sert au webhook Stripe)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de prix créés dans le dashboard Stripe (Produit "MY FUNDED BOOK")
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_...

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudflare R2 (stockage images/PDF — 100% gratuit) ----
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=myfundedbook
# URL publique du bucket : domaine r2.dev OU ton domaine custom (sans slash final)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
